{
  "id": "/web/",
  "name": "Tapan — personal assistant",
  "short_name": "Tapan",
  "description": "Your personal AI assistant: reminders, tasks, notes, web search and memory of every conversation.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/web/index.html?source=pwa",
  "scope": "/web/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0c0f15",
  "theme_color": "#0c0f15",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg?v=2", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "icons/shot-narrow.png?v=2", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "Chat, with shortcuts for the day" },
    { "src": "icons/shot-wide.png?v=2", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Chat and today's reminders side by side" }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "New chat",
      "description": "Start a fresh conversation",
      "url": "/web/index.html?new=1&source=shortcut",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Reminders and tasks for today",
      "url": "/web/index.html?panel=today&source=shortcut",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
