# Copy to .env and fill in. Never commit .env.

# ── Who is the assistant talking to? ────────────────────────────
TAPAN_ASSISTANT_NAME=Tapan
TAPAN_USER_NAME=
TAPAN_HOME_LOCATION=            # default city for weather + daily briefing, e.g. Mumbai
TAPAN_TIMEZONE=                 # e.g. Asia/Kolkata (blank = this machine's timezone)

# ── LLM: OmniRoute (recommended) ────────────────────────────────
# OmniRoute is a self-hosted OpenAI-compatible gateway that routes/fails over across many providers.
# Run it locally (default port 20128), copy a key from its Dashboard -> Endpoints.
TAPAN_LLM_PROVIDER=omniroute    # omniroute | openrouter | ollama | mock (mock = offline, no LLM)
TAPAN_OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
TAPAN_OMNIROUTE_MODEL=auto      # or auto/fast, auto/coding, or a specific provider/model id
TAPAN_OMNIROUTE_TIMEOUT=60

# ── LLM fallbacks (tried automatically if the first provider fails) ──
OPENROUTER_API_KEY=
# Cheap + good at tool calling (~$0.10 in / $0.50 out per 1M tokens). Browse https://openrouter.ai/models
TAPAN_OPENROUTER_MODEL=anthropic/claude-haiku-5.5
TAPAN_OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# TAPAN_OLLAMA_URL=http://localhost:11434/api/chat
# TAPAN_OLLAMA_MODEL=qwen2.5:7b

# ── Agent behaviour ─────────────────────────────────────────────
TAPAN_AGENT_ENABLED=true
TAPAN_AGENT_MAX_STEPS=6
TAPAN_AGENT_HISTORY_TURNS=10
TAPAN_REMINDER_POLL_SECONDS=20

# ── Local-machine skills (read/write files, open apps/links) ────
# On by default when TAPAN_ENV=local, off otherwise. Files are sandboxed to the workspace folder.
# TAPAN_ENABLE_LOCAL_SKILLS=true
TAPAN_WORKSPACE_DIR=data/workspace
# TAPAN_APP_ALLOWLIST=notepad=notepad,calculator=calc,explorer=explorer,vscode=code,spotify=spotify

# ── Push notifications (reminders on your lock screen) ──────────
# Works out of the box: a VAPID key pair is generated on first start and stored in the database.
# TAPAN_PUSH_ENABLED=true
# TAPAN_VAPID_PRIVATE_KEY=       # optional: pin your own key (base64url, 32 bytes) instead of the generated one
# TAPAN_VAPID_SUBJECT=           # optional https:// or mailto: contact. It is SHARED with Google/Apple/Mozilla/Microsoft's push
#                                # services, so the default is this site's URL, never a personal email address.

# ── Money tab (payments, EMIs, banks) ───────────────────────────
TAPAN_CURRENCY=INR              # ISO code shown in the Money tab and reminders (INR groups digits 12,34,567)

# ── Telegram (reminders + chat on any phone, including iPhone) ──
# Easiest: leave these blank and paste the BotFather token in Settings > Telegram instead (it is stored in the database).
# TAPAN_TELEGRAM_BOT_TOKEN=
# TAPAN_PUBLIC_URL=https://your-app.onrender.com   # only needed if the server cannot work out its own https address

# ── Server / security ───────────────────────────────────────────
TAPAN_ENV=local                 # local | dev | prod — anything except local REQUIRES TAPAN_API_TOKEN
TAPAN_API_HOST=127.0.0.1        # use 0.0.0.0 only behind a token (Docker image does this for you)
TAPAN_API_PORT=8000             # Render supplies PORT automatically
TAPAN_API_TOKEN=                # long random string; the UI will ask for it once
# TAPAN_CORS_ORIGINS=https://my-other-site.example
TAPAN_RATE_LIMIT_PER_MINUTE=30

# ── Database ────────────────────────────────────────────────────
# Blank = local SQLite file (data/…). Set to use Postgres instead, e.g. Supabase:
#   Supabase dashboard -> Connect -> "Session pooler" -> copy the URI, put your database password in it
#   (URL-encode special characters). Use the pooler URI, not the direct db.<ref>.supabase.co one (IPv6-only).
TAPAN_DATABASE_URL=

# ── Optional cloud memory sync ──────────────────────────────────
TAPAN_SUPERMEMORY_API_KEY=
# TAPAN_PG_BATCH=1                 # 0 = send each statement of a transaction separately (slower on a remote database)
